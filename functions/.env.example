# Cloud Functions environment (copy to functions/.env for emulators).
# For production, set the same key in Firebase Console → Functions → Environment
# or via `firebase functions:config` / dotenv deploy.
#
# Keep false until App Check providers are enabled in Firebase Console
# (Play Integrity + App Attest/DeviceCheck) and debug tokens are registered.
# Then set true and redeploy functions.
ENFORCE_APP_CHECK=false
