rules_version = '2';

// Deploy after changes: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin(database);

      allow create: if isOwner(userId)
        && hasRequiredProfileFields()
        && isValidProfileData()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && onlyProfileFieldsChanged()
        && isValidProfileDataAfterUpdate();

      allow delete: if isOwner(userId);

      match /continueLearningProgress/{playlistId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidContinueLearningProgress();
        allow delete: if isOwner(userId);
      }

      match /examAttempts/{attemptId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidExamAttemptCreate();
        allow update, delete: if false;
      }

      match /quizAttempts/{quizId} {
        allow read: if isOwner(userId) || isAdmin(database);
        allow create: if isOwner(userId) && isValidQuizAttemptCreate(quizId);
        allow update: if isOwner(userId) && isValidQuizAttemptUpdate(database, quizId);
        allow delete: if isAdmin(database);
      }

      match /fcmTokens/{tokenId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidFcmTokenWrite();
        allow delete: if isOwner(userId);
      }

      match /notificationPreferences/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidNotificationPreferencesWrite();
        allow delete: if isOwner(userId);
      }

      match /notificationReads/{notificationId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidNotificationReadWrite();
        allow delete: if isOwner(userId);
      }
    }

    match /appContent/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin(database) && isValidAppContentSection();
      allow delete: if isAdmin(database);
    }

    match /importantUpdates/{noticeId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(database) && isValidImportantUpdateNoticeCreate();
      allow update: if isAdmin(database) && isValidImportantUpdateNoticeUpdate();
      allow delete: if isAdmin(database);
    }

    match /upcomingEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(database) && isValidUpcomingEventCreate();
      allow update: if isAdmin(database) && isValidUpcomingEventUpdate();
      allow delete: if isAdmin(database);
    }

    match /continueLearningPlaylists/{playlistId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(database) && isValidContinueLearningPlaylistCreate();
      allow update: if isAdmin(database) && isValidContinueLearningPlaylistUpdate();
      allow delete: if isAdmin(database);
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(database) && isValidCourseCreate();
      allow update: if isAdmin(database) && isValidCourseUpdate();
      allow delete: if isAdmin(database);
    }

    match /resourceNotes/{noteId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(database) && isValidResourceNoteCreate();
      allow update: if isAdmin(database) && isValidResourceNoteUpdate();
      allow delete: if isAdmin(database);
    }

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(database) && isValidAssignmentCreate();
      allow update: if isAdmin(database) && isValidAssignmentUpdate();
      allow delete: if isAdmin(database);
    }

    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(database) && isValidExamCreate();
      allow update: if isAdmin(database) && isValidExamUpdate();
      allow delete: if isAdmin(database);
    }

    match /quizCompetitions/{quizId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(database) && isValidQuizCompetitionCreate();
      allow update: if isAdmin(database) && isValidQuizCompetitionUpdate();
      allow delete: if isAdmin(database);
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(database) && isValidNotificationCreate();
      allow update: if isAdmin(database) && isValidNotificationUpdate();
      allow delete: if isAdmin(database);
    }

    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(database) && isValidSchoolCreate();
      allow update: if isAdmin(database) && isValidSchoolUpdate();
      allow delete: if isAdmin(database);
    }

    match /chatKeywords/{keywordId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(database) && isValidChatKeywordCreate();
      allow update: if isAdmin(database) && isValidChatKeywordUpdate();
      allow delete: if isAdmin(database);
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(database) && isValidProjectCreate();
      allow update: if isAdmin(database) && isValidProjectUpdate();
      allow delete: if isAdmin(database);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isAuthenticated() {
  return request.auth != null;
}

function isAdmin(database) {
  return isAuthenticated()
    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
}

function isOwner(userId) {
  return request.auth != null && request.auth.uid == userId;
}

function isValidAppContentSection() {
  let data = request.resource.data;
  return data.sectionTitle is string
    && data.sectionTitle.size() > 0
    && data.sectionTitle.size() <= 120
    && data.sectionSubtitle is string
    && data.sectionSubtitle.size() <= 200
    && data.actionLabel is string
    && data.actionLabel.size() <= 60;
}

function isValidSchoolGradeIdsMap(data) {
  return !('schoolGradeIds' in data)
    || (
      data.schoolGradeIds is map
      && data.schoolGradeIds.size() <= 50
    );
}

function isValidSchoolAudienceFields(data) {
  return (!('audience' in data) || data.audience == 'all' || data.audience == 'schools')
    && (
      !('schoolIds' in data)
      || (
        data.schoolIds is list
        && data.schoolIds.size() <= 50
        && (data.audience != 'schools' || data.schoolIds.size() >= 1)
      )
    )
    && isValidSchoolGradeIdsMap(data);
}

function isValidImportantUpdateNoticeFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.tag is string
    && data.tag.size() <= 60
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.description is string
    && data.description.size() <= 600
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidImportantUpdateNoticeCreate() {
  let data = request.resource.data;
  return data.keys().hasAll([
      'tag',
      'title',
      'subtitle',
      'description',
      'sortOrder',
      'isPublished',
      'createdAt',
      'updatedAt',
    ])
    && isValidImportantUpdateNoticeFields(data)
    && isValidCourseTrack(data);
}

function isValidImportantUpdateNoticeUpdate() {
  return isValidImportantUpdateNoticeFields(request.resource.data);
}

function isValidUpcomingEventFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.month is string
    && data.month.size() > 0
    && data.month.size() <= 20
    && data.day is string
    && data.day.size() > 0
    && data.day.size() <= 10
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.dateRange is string
    && data.dateRange.size() <= 100
    && data.timeRange is string
    && data.timeRange.size() <= 100
    && data.daysLeftLabel is string
    && data.daysLeftLabel.size() <= 40
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidUpcomingEventCreate() {
  return isValidUpcomingEventFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidUpcomingEventUpdate() {
  return isValidUpcomingEventFields(request.resource.data);
}

function isValidContinueLearningPlaylistFields(data) {
  return isValidSchoolAudienceFields(data)
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.imageUri is string
    && data.imageUri.size() <= 8192
    && data.playlistUrl is string
    && data.playlistUrl.size() > 0
    && data.playlistUrl.size() <= 8192
    && data.videoCount is number
    && data.videoCount >= 1
    && data.videoCount <= 500
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool
    && (!('track' in data) || isValidCourseTrack(data));
}

function isValidContinueLearningPlaylistCreate() {
  return isValidContinueLearningPlaylistFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidContinueLearningPlaylistUpdate() {
  return isValidContinueLearningPlaylistFields(request.resource.data);
}

function isValidCourseTrack(data) {
  return data.track in ['kids', 'professionals'];
}

function isValidCourseFields(data) {
  return isValidSchoolAudienceFields(data)
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.imageUri is string
    && data.imageUri.size() <= 8192
    && data.durationLabel is string
    && data.durationLabel.size() <= 40
    && data.description is string
    && data.description.size() <= 600
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool
    // Track is required on create; legacy docs may omit it until edited.
    && (!('track' in data) || isValidCourseTrack(data));
}

function isValidCourseCreate() {
  return isValidCourseFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidCourseUpdate() {
  return isValidCourseFields(request.resource.data);
}

function isValidResourceNoteFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.pdfUrl is string
    && data.pdfUrl.size() <= 8192
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidResourceNoteCreate() {
  return isValidResourceNoteFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidResourceNoteUpdate() {
  return isValidResourceNoteFields(request.resource.data);
}

function isValidAssignmentFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.dueDateLabel is string
    && data.dueDateLabel.size() <= 80
    && data.pdfUrl is string
    && data.pdfUrl.size() <= 8192
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidAssignmentCreate() {
  return isValidAssignmentFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidAssignmentUpdate() {
  return isValidAssignmentFields(request.resource.data);
}

function isValidExamFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.description is string
    && data.description.size() <= 1000
    && data.timerSeconds is number
    && data.timerSeconds >= 0
    && data.questions is list
    && data.questions.size() >= 0
    && data.questions.size() <= 500
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidExamCreate() {
  return isValidExamFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidExamUpdate() {
  return isValidExamFields(request.resource.data);
}

function isValidQuizCompetitionFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.description is string
    && data.description.size() <= 1000
    && data.timerSeconds is number
    && data.timerSeconds >= 0
    && (!('xpValue' in data) || (data.xpValue is number && data.xpValue >= 0 && data.xpValue <= 10000))
    && (!('allowRetry' in data) || data.allowRetry is bool)
    && data.questions is list
    && data.questions.size() >= 0
    && data.questions.size() <= 500
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidQuizCompetitionCreate() {
  return isValidQuizCompetitionFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidQuizCompetitionUpdate() {
  return isValidQuizCompetitionFields(request.resource.data);
}

function isValidNotificationCategory(value) {
  return value == null
    || value in [
      'general',
      'course_updates',
      'live_class_reminders',
      'assignment_deadlines',
      'progress_achievements',
      'security_alerts',
      'account_changes',
      'app_updates',
      'events_workshops',
      'promotional_offers'
    ];
}

function isValidNotificationFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.body is string
    && data.body.size() > 0
    && data.body.size() <= 2000
    && isValidNotificationCategory(data.category)
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidNotificationPreferencesWrite() {
  let data = request.resource.data;
  return data.pushNotifications is bool
    && data.soundAndVibration is bool
    && data.courseUpdates is bool
    && data.liveClassReminders is bool
    && data.assignmentDeadlines is bool
    && data.progressAchievements is bool
    && data.securityAlerts is bool
    && data.accountChanges is bool
    && data.appUpdates is bool
    && data.promotionalOffers is bool
    && data.eventsAndWorkshops is bool;
}

function isValidNotificationReadWrite() {
  let data = request.resource.data;
  return data.readAt == request.time
    && data.keys().hasOnly(['readAt']);
}

function isValidFcmTokenWrite() {
  let data = request.resource.data;
  return data.token is string
    && data.token.size() > 0
    && data.token.size() <= 4096
    && data.platform is string
    && data.platform in ['ios', 'android']
    && data.updatedAt == request.time;
}

function isValidNotificationCreate() {
  return isValidNotificationFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidNotificationUpdate() {
  return isValidNotificationFields(request.resource.data);
}

function isValidSchoolFields(data) {
  return data.name is string
    && data.name.size() > 0
    && data.name.size() <= 200
    && data.city is string
    && data.city.size() <= 200
    && data.sortOrder is number
    && data.sortOrder >= 0;
}

function isValidSchoolCreate() {
  return isValidSchoolFields(request.resource.data);
}

function isValidSchoolUpdate() {
  return isValidSchoolFields(request.resource.data);
}

function isValidChatKeywordFields(data) {
  return data.label is string
    && data.label.size() > 0
    && data.label.size() <= 80
    && data.response is string
    && data.response.size() <= 1000
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidChatKeywordCreate() {
  return isValidChatKeywordFields(request.resource.data);
}

function isValidChatKeywordUpdate() {
  return isValidChatKeywordFields(request.resource.data);
}

function isValidProjectFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.description is string
    && data.description.size() <= 600
    && data.imageUri is string
    && data.imageUri.size() <= 8192
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidProjectCreate() {
  let data = request.resource.data;
  return data.keys().hasAll([
      'title',
      'subtitle',
      'description',
      'imageUri',
      'sortOrder',
      'isPublished',
      'createdAt',
      'updatedAt',
    ])
    && isValidProjectFields(data)
    && isValidCourseTrack(data);
}

function isValidProjectUpdate() {
  return isValidProjectFields(request.resource.data);
}

function isValidExamAttemptCreate() {
  let data = request.resource.data;
  return data.examId is string
    && data.examId.size() > 0
    && data.examId.size() <= 200
    && data.answers is map
    && data.answers.size() >= 0
    && data.answers.size() <= 500
    && data.correctCount is number
    && data.correctCount >= 0
    && data.correctCount <= 500
    && data.totalQuestions is number
    && data.totalQuestions >= 0
    && data.totalQuestions <= 500
    && data.percentage is number
    && data.percentage >= 0
    && data.percentage <= 100
    && data.submittedAt == request.time;
}

function isValidQuizAttemptFields(quizId) {
  let data = request.resource.data;
  return quizId.size() > 0
    && quizId.size() <= 200
    && data.quizId == quizId
    && data.answers is map
    && data.answers.size() >= 0
    && data.answers.size() <= 500
    && data.correctCount is number
    && data.correctCount >= 0
    && data.correctCount <= 500
    && data.totalQuestions is number
    && data.totalQuestions >= 0
    && data.totalQuestions <= 500
    && data.percentage is number
    && data.percentage >= 0
    && data.percentage <= 100
    && data.xpEarned is number
    && data.xpEarned >= 0
    && data.xpEarned <= 10000
    && data.submittedAt == request.time;
}

function quizAllowsRetry(database, quizId) {
  return exists(/databases/$(database)/documents/quizCompetitions/$(quizId))
    && get(/databases/$(database)/documents/quizCompetitions/$(quizId)).data.allowRetry == true;
}

function quizAttemptAllowsScoreRetry(database, userId, quizId) {
  let attemptPath = /databases/$(database)/documents/users/$(userId)/quizAttempts/$(quizId);
  return exists(attemptPath)
    && get(attemptPath).data.percentage is number
    && get(attemptPath).data.percentage < 100;
}

function isValidQuizAttemptCreate(quizId) {
  return isValidQuizAttemptFields(quizId);
}

function isValidQuizAttemptUpdate(database, quizId) {
  return isValidQuizAttemptFields(quizId)
    && (
      quizAllowsRetry(database, quizId)
      || quizAttemptAllowsScoreRetry(database, request.auth.uid, quizId)
    );
}

function isValidContinueLearningProgress() {
  let data = request.resource.data;
  return data.videosWatched is number
    && data.videosWatched >= 0
    && data.videosWatched <= 500
    && (!('hasStartedWatching' in data) || data.hasStartedWatching is bool)
    && (
      !('watchSecondsByVideoId' in data)
      || (
        data.watchSecondsByVideoId is map
        && data.watchSecondsByVideoId.size() <= 500
      )
    );
}

function hasRequiredProfileFields() {
  return request.resource.data.keys().hasAll([
    'fullName',
    'email',
    'phoneNumber',
    'profileImage',
    'role',
    'createdAt',
    'updatedAt',
  ]);
}

function isValidProfileData() {
  let data = request.resource.data;
  return data.fullName is string
    && data.fullName.size() > 0
    && data.fullName.size() <= 120
    && data.email is string
    && data.email.size() > 0
    && data.email.size() <= 320
    && data.phoneNumber is string
    && data.phoneNumber.size() >= 10
    && data.phoneNumber.size() <= 15
    && isValidUserRole(data.role)
    && isOptionalProfileImage(data.profileImage)
    && isOptionalSchoolId(data.schoolId)
    && isOptionalGrade(data.grade)
    && isOptionalUserTrack(data.track);
}

// Updates use .update() with partial fields — validate merged document, not serverTimestamp equality.
function onlyProfileFieldsChanged() {
  return request.resource.data.diff(resource.data).affectedKeys()
    .hasOnly(['fullName', 'phoneNumber', 'profileImage', 'schoolId', 'grade', 'track', 'updatedAt']);
}

function isValidProfileDataAfterUpdate() {
  let data = request.resource.data;
  return data.fullName is string
    && data.fullName.size() > 0
    && data.fullName.size() <= 120
    && data.phoneNumber is string
    && data.phoneNumber.size() >= 10
    && data.phoneNumber.size() <= 15
    && hasValidProfileRoleField(data)
    && isOptionalProfileImage(data.profileImage)
    && isOptionalSchoolId(data.schoolId)
    && isOptionalGrade(data.grade)
    && isOptionalUserTrack(data.track);
}

function isValidUserRole(value) {
  return value == 'user' || value == 'admin';
}

function hasValidProfileRoleField(data) {
  return !('role' in data) || data.role == null || isValidUserRole(data.role);
}

function isOptionalProfileImage(value) {
  return value == null
    || value == ''
    || (value is string && value.size() <= 8192);
}

function isOptionalSchoolId(value) {
  return value == null
    || value == ''
    || (value is string && value.size() > 0 && value.size() <= 128);
}

function isOptionalGrade(value) {
  return value == null
    || value == ''
    || (value is string && value.size() > 0 && value.size() <= 32);
}

function isOptionalUserTrack(value) {
  return value == null
    || value in ['kids', 'professionals'];
}
