rules_version = '2';

// Deploy after changes: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && hasRequiredProfileFields()
        && isValidProfileData()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && onlyProfileFieldsChanged()
        && isValidProfileDataAfterUpdate();

      allow delete: if isOwner(userId);
    }

    match /appContent/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidAppContentSection();
      allow delete: if isAdmin();
    }

    match /importantUpdates/{noticeId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidImportantUpdateNoticeCreate();
      allow update: if isAdmin() && isValidImportantUpdateNoticeUpdate();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isAuthenticated() {
  return request.auth != null;
}

function isAdmin() {
  return isAuthenticated()
    && exists(/databases/(default)/documents/users/$(request.auth.uid))
    && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
}

function isOwner(userId) {
  return request.auth != null && request.auth.uid == userId;
}

function isValidAppContentSection() {
  let data = request.resource.data;
  return data.sectionTitle is string
    && data.sectionTitle.size() > 0
    && data.sectionTitle.size() <= 120
    && data.sectionSubtitle is string
    && data.sectionSubtitle.size() <= 200
    && data.actionLabel is string
    && data.actionLabel.size() <= 60;
}

function isValidImportantUpdateNoticeFields(data) {
  return data.tag is string
    && data.tag.size() <= 60
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.description is string
    && data.description.size() <= 600
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidImportantUpdateNoticeCreate() {
  let data = request.resource.data;
  return data.keys().hasAll([
      'tag',
      'title',
      'subtitle',
      'description',
      'sortOrder',
      'isPublished',
      'createdAt',
      'updatedAt',
    ])
    && isValidImportantUpdateNoticeFields(data);
}

function isValidImportantUpdateNoticeUpdate() {
  return isValidImportantUpdateNoticeFields(request.resource.data);
}

function hasRequiredProfileFields() {
  return request.resource.data.keys().hasAll([
    'fullName',
    'email',
    'phoneNumber',
    'profileImage',
    'role',
    'createdAt',
    'updatedAt',
  ]);
}

function isValidProfileData() {
  let data = request.resource.data;
  return data.fullName is string
    && data.fullName.size() > 0
    && data.fullName.size() <= 120
    && data.email is string
    && data.email.size() > 0
    && data.email.size() <= 320
    && data.phoneNumber is string
    && data.phoneNumber.size() >= 10
    && data.phoneNumber.size() <= 15
    && isValidUserRole(data.role)
    && isOptionalProfileImage(data.profileImage);
}

// Updates use .update() with partial fields — validate merged document, not serverTimestamp equality.
function onlyProfileFieldsChanged() {
  return request.resource.data.diff(resource.data).affectedKeys()
    .hasOnly(['fullName', 'phoneNumber', 'profileImage', 'updatedAt']);
}

function isValidProfileDataAfterUpdate() {
  let data = request.resource.data;
  return data.fullName is string
    && data.fullName.size() > 0
    && data.fullName.size() <= 120
    && data.phoneNumber is string
    && data.phoneNumber.size() >= 10
    && data.phoneNumber.size() <= 15
    && isValidUserRole(data.role)
    && isOptionalProfileImage(data.profileImage);
}

function isValidUserRole(value) {
  return value == 'user' || value == 'admin';
}

function isOptionalProfileImage(value) {
  return value == null
    || (value is string && value.size() <= 8192);
}
