rules_version = '2';

// Deploy after changes: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin(database);

      // New accounts always start as "user". Superadmins are promoted explicitly.
      allow create: if isOwner(userId)
        && hasRequiredProfileFields()
        && isValidProfileData()
        && request.resource.data.role == 'user'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Owners may edit their own profile fields (not role).
      // Superadmins may update any user, including role (user or admin only).
      // schoolId and grade are write-once: once set, they cannot change.
      allow update: if (isOwner(userId)
          && onlyProfileFieldsChanged()
          && isValidProfileDataAfterUpdate()
          && schoolAndGradeImmutableOnceSet())
        || (isSuperAdmin(database)
          && onlyRoleFieldsChanged()
          && isValidSuperAdminRoleAssignment())
        || (isSuperAdmin(database)
          && onlySuperAdminUserFieldsChanged()
          && isValidProfileDataAfterSuperAdminUpdate()
          && schoolAndGradeImmutableOnceSet());

      allow delete: if isOwner(userId) || isSuperAdmin(database);

      match /continueLearningProgress/{playlistId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidContinueLearningProgress();
        allow delete: if isOwner(userId);
      }

      match /examAttempts/{attemptId} {
        allow read: if isOwner(userId);
        // Scores are written only by Cloud Functions (Admin SDK).
        allow create, update, delete: if false;
      }

      match /quizAttempts/{quizId} {
        allow read: if isOwner(userId) || isSuperAdmin(database);
        // Scores are written only by Cloud Functions (Admin SDK).
        allow create, update: if false;
        allow delete: if isSuperAdmin(database);
      }

      match /fcmTokens/{tokenId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidFcmTokenWrite();
        allow delete: if isOwner(userId);
      }

      match /notificationPreferences/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidNotificationPreferencesWrite();
        allow delete: if isOwner(userId);
      }

      match /notificationReads/{notificationId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidNotificationReadWrite();
        allow delete: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------------
    // Superadmin-only CMS collections (except appContent resources /
    // assignments section docs, which plain admins may also edit).
    // Role "admin" is limited to resources/assignments/exams/quizzes,
    // matching the admin-dashboard screens they can open.
    // ---------------------------------------------------------------

    match /appContent/{docId} {
      allow read: if isAuthenticated();
      // Superadmin: all section docs. Plain admin: Resources + Assignments
      // headings only (screens they can manage).
      allow create, update: if isValidAppContentSection()
        && (
          isSuperAdmin(database)
          || (
            isAdmin(database)
            && (docId == 'resources' || docId == 'assignments')
          )
        );
      allow delete: if isSuperAdmin(database);
    }

    match /importantUpdates/{noticeId} {
      allow read: if canReadPublishedContent(database);
      allow create: if isSuperAdmin(database) && isValidImportantUpdateNoticeCreate();
      allow update: if isSuperAdmin(database) && isValidImportantUpdateNoticeUpdate();
      allow delete: if isSuperAdmin(database);
    }

    match /upcomingEvents/{eventId} {
      allow read: if canReadPublishedContent(database);
      allow create: if isSuperAdmin(database) && isValidUpcomingEventCreate();
      allow update: if isSuperAdmin(database) && isValidUpcomingEventUpdate();
      allow delete: if isSuperAdmin(database);
    }

    match /continueLearningPlaylists/{playlistId} {
      allow read: if canReadPublishedContent(database);
      allow create: if isSuperAdmin(database) && isValidContinueLearningPlaylistCreate();
      allow update: if isSuperAdmin(database) && isValidContinueLearningPlaylistUpdate();
      allow delete: if isSuperAdmin(database);
    }

    match /courses/{courseId} {
      allow read: if canReadPublishedContent(database);
      allow create: if isSuperAdmin(database) && isValidCourseCreate();
      allow update: if isSuperAdmin(database) && isValidCourseUpdate();
      allow delete: if isSuperAdmin(database);
    }

    // ---------------------------------------------------------------
    // Collections writable by role "admin" (and superadmin).
    // ---------------------------------------------------------------

    match /resourceNotes/{noteId} {
      allow read: if canReadPublishedContent(database);
      allow create: if isAdmin(database) && isValidResourceNoteCreate();
      allow update: if isAdmin(database) && isValidResourceNoteUpdate();
      allow delete: if isAdmin(database);
    }

    match /assignments/{assignmentId} {
      allow read: if canReadPublishedContent(database);
      allow create: if isAdmin(database) && isValidAssignmentCreate();
      allow update: if isAdmin(database) && isValidAssignmentUpdate();
      allow delete: if isAdmin(database);
    }

    match /exams/{examId} {
      allow read: if canReadPublishedContent(database);
      allow create: if isAdmin(database) && isValidExamCreate();
      allow update: if isAdmin(database) && isValidExamUpdate();
      allow delete: if isAdmin(database);
    }

    match /examAnswerKeys/{examId} {
      allow read, write: if isAdmin(database);
    }

    match /quizCompetitions/{quizId} {
      allow read: if canReadPublishedContent(database);
      allow create: if isAdmin(database) && isValidQuizCompetitionCreate();
      allow update: if isAdmin(database) && isValidQuizCompetitionUpdate();
      allow delete: if isAdmin(database);
    }

    match /quizAnswerKeys/{quizId} {
      allow read, write: if isAdmin(database);
    }

    // Superadmin-only: notifications, schools, chat keywords, projects.

    match /notifications/{notificationId} {
      allow read: if canReadPublishedContent(database);
      allow create: if isSuperAdmin(database) && isValidNotificationCreate();
      allow update: if isSuperAdmin(database) && isValidNotificationUpdate();
      allow delete: if isSuperAdmin(database);
    }

    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin(database) && isValidSchoolCreate();
      allow update: if isSuperAdmin(database) && isValidSchoolUpdate();
      allow delete: if isSuperAdmin(database);
    }

    match /chatKeywords/{keywordId} {
      allow read: if canReadPublishedContent(database);
      allow create: if isSuperAdmin(database) && isValidChatKeywordCreate();
      allow update: if isSuperAdmin(database) && isValidChatKeywordUpdate();
      allow delete: if isSuperAdmin(database);
    }

    match /projects/{projectId} {
      allow read: if canReadPublishedContent(database);
      allow create: if isSuperAdmin(database) && isValidProjectCreate();
      allow update: if isSuperAdmin(database) && isValidProjectUpdate();
      allow delete: if isSuperAdmin(database);
    }

    // Class forum — school+grade channels. Admins/superadmins are global facilitators.
    match /classForumChannels/{channelId} {
      allow read: if canReadClassForumChannel(database);
      allow create: if canCreateClassForumChannel(database);
      allow update: if canUpdateClassForumChannel(database);
      allow delete: if isSuperAdmin(database);

      match /messages/{messageId} {
        allow read: if canAccessClassForumChannelId(database, channelId);
        allow create: if canCreateClassForumMessage(database, channelId);
        allow update: if isAdmin(database) && isValidClassForumMessagePinUpdate();
        allow delete: if canDeleteClassForumMessage(database);
      }

      match /reports/{reportId} {
        allow read: if isAdmin(database);
        allow create: if canCreateClassForumReport(database, channelId);
        allow update, delete: if isSuperAdmin(database);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }

function isAuthenticated() {
  return request.auth != null;
}

/** Admin dashboard access (admin or superadmin). */
function isAdmin(database) {
  return isAuthenticated()
    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && (
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
      || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
    );
}

/** Learners only see published CMS docs; admins see drafts too. */
function canReadPublishedContent(database) {
  return isAuthenticated()
    && (
      resource.data.isPublished == true
      || isAdmin(database)
    );
}

function isSuperAdmin(database) {
  return isAuthenticated()
    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
}

function isOwner(userId) {
  return request.auth != null && request.auth.uid == userId;
}

function isValidAppContentSection() {
  let data = request.resource.data;
  return data.sectionTitle is string
    && data.sectionTitle.size() > 0
    && data.sectionTitle.size() <= 120
    && data.sectionSubtitle is string
    && data.sectionSubtitle.size() <= 200
    && data.actionLabel is string
    && data.actionLabel.size() <= 60;
}

function isValidSchoolGradeIdsMap(data) {
  return !('schoolGradeIds' in data)
    || (
      data.schoolGradeIds is map
      && data.schoolGradeIds.size() <= 50
    );
}

function isValidSchoolAudienceFields(data) {
  return (!('audience' in data) || data.audience == 'all' || data.audience == 'schools')
    && (
      !('schoolIds' in data)
      || (
        data.schoolIds is list
        && data.schoolIds.size() <= 50
        && (data.audience != 'schools' || data.schoolIds.size() >= 1)
      )
    )
    && isValidSchoolGradeIdsMap(data);
}

function isValidImportantUpdateNoticeFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.tag is string
    && data.tag.size() <= 60
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.description is string
    && data.description.size() <= 600
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidImportantUpdateNoticeCreate() {
  let data = request.resource.data;
  return data.keys().hasAll([
      'tag',
      'title',
      'subtitle',
      'description',
      'sortOrder',
      'isPublished',
      'createdAt',
      'updatedAt',
    ])
    && isValidImportantUpdateNoticeFields(data)
    && isValidCourseTrack(data);
}

function isValidImportantUpdateNoticeUpdate() {
  return isValidImportantUpdateNoticeFields(request.resource.data);
}

function isValidUpcomingEventFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.month is string
    && data.month.size() > 0
    && data.month.size() <= 20
    && data.day is string
    && data.day.size() > 0
    && data.day.size() <= 10
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.dateRange is string
    && data.dateRange.size() <= 100
    && data.timeRange is string
    && data.timeRange.size() <= 100
    && data.daysLeftLabel is string
    && data.daysLeftLabel.size() <= 40
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidUpcomingEventCreate() {
  return isValidUpcomingEventFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidUpcomingEventUpdate() {
  return isValidUpcomingEventFields(request.resource.data);
}

function isValidContinueLearningPlaylistFields(data) {
  return isValidSchoolAudienceFields(data)
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.imageUri is string
    && data.imageUri.size() <= 8192
    && data.playlistUrl is string
    && data.playlistUrl.size() > 0
    && data.playlistUrl.size() <= 8192
    && data.videoCount is number
    && data.videoCount >= 1
    && data.videoCount <= 500
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool
    && (!('track' in data) || isValidCourseTrack(data));
}

function isValidContinueLearningPlaylistCreate() {
  return isValidContinueLearningPlaylistFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidContinueLearningPlaylistUpdate() {
  return isValidContinueLearningPlaylistFields(request.resource.data);
}

function isValidCourseTrack(data) {
  return data.track in ['kids', 'professionals'];
}

function isValidCourseFields(data) {
  return isValidSchoolAudienceFields(data)
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.imageUri is string
    && data.imageUri.size() <= 8192
    && data.durationLabel is string
    && data.durationLabel.size() <= 40
    && data.description is string
    && data.description.size() <= 600
    && (
      !('syllabusPdfUrl' in data)
      || (
        data.syllabusPdfUrl is string
        && data.syllabusPdfUrl.size() <= 8192
      )
    )
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool
    // Track is required on create; legacy docs may omit it until edited.
    && (!('track' in data) || isValidCourseTrack(data));
}

function isValidCourseCreate() {
  return isValidCourseFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidCourseUpdate() {
  return isValidCourseFields(request.resource.data);
}

function isValidResourceNoteFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.pdfUrl is string
    && data.pdfUrl.size() <= 8192
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidResourceNoteCreate() {
  return isValidResourceNoteFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidResourceNoteUpdate() {
  return isValidResourceNoteFields(request.resource.data);
}

function isValidAssignmentFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.dueDateLabel is string
    && data.dueDateLabel.size() <= 80
    && data.pdfUrl is string
    && data.pdfUrl.size() <= 8192
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidAssignmentCreate() {
  return isValidAssignmentFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidAssignmentUpdate() {
  return isValidAssignmentFields(request.resource.data);
}

function isValidExamFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.description is string
    && data.description.size() <= 1000
    && data.timerSeconds is number
    && data.timerSeconds >= 0
    && data.questions is list
    && data.questions.size() >= 0
    && data.questions.size() <= 500
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidExamCreate() {
  return isValidExamFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidExamUpdate() {
  return isValidExamFields(request.resource.data);
}

function isValidQuizCompetitionFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.description is string
    && data.description.size() <= 1000
    && data.timerSeconds is number
    && data.timerSeconds >= 0
    && (!('xpValue' in data) || (data.xpValue is number && data.xpValue >= 0 && data.xpValue <= 10000))
    && (!('allowRetry' in data) || data.allowRetry is bool)
    && data.questions is list
    && data.questions.size() >= 0
    && data.questions.size() <= 500
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidQuizCompetitionCreate() {
  return isValidQuizCompetitionFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidQuizCompetitionUpdate() {
  return isValidQuizCompetitionFields(request.resource.data);
}

function isValidNotificationCategory(value) {
  return value == null
    || value in [
      'general',
      'course_updates',
      'live_class_reminders',
      'assignment_deadlines',
      'progress_achievements',
      'security_alerts',
      'account_changes',
      'app_updates',
      'events_workshops',
      'promotional_offers'
    ];
}

function isValidNotificationFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.body is string
    && data.body.size() > 0
    && data.body.size() <= 2000
    && isValidNotificationCategory(data.category)
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidNotificationPreferencesWrite() {
  let data = request.resource.data;
  return data.pushNotifications is bool
    && data.soundAndVibration is bool
    && data.courseUpdates is bool
    && data.liveClassReminders is bool
    && data.assignmentDeadlines is bool
    && data.progressAchievements is bool
    && data.securityAlerts is bool
    && data.accountChanges is bool
    && data.appUpdates is bool
    && data.promotionalOffers is bool
    && data.eventsAndWorkshops is bool;
}

function isValidNotificationReadWrite() {
  let data = request.resource.data;
  return data.readAt == request.time
    && data.keys().hasOnly(['readAt']);
}

function isValidFcmTokenWrite() {
  let data = request.resource.data;
  return data.token is string
    && data.token.size() > 0
    && data.token.size() <= 4096
    && data.platform is string
    && data.platform in ['ios', 'android']
    && data.updatedAt == request.time;
}

function isValidNotificationCreate() {
  return isValidNotificationFields(request.resource.data)
    && isValidCourseTrack(request.resource.data);
}

function isValidNotificationUpdate() {
  return isValidNotificationFields(request.resource.data);
}

function isValidSchoolFields(data) {
  return data.name is string
    && data.name.size() > 0
    && data.name.size() <= 200
    && data.city is string
    && data.city.size() <= 200
    && data.sortOrder is number
    && data.sortOrder >= 0
    && (
      !('grades' in data)
      || (
        data.grades is list
        && data.grades.size() <= 40
      )
    );
}

function isValidSchoolCreate() {
  return isValidSchoolFields(request.resource.data);
}

function isValidSchoolUpdate() {
  return isValidSchoolFields(request.resource.data);
}

function isValidChatKeywordFields(data) {
  return data.label is string
    && data.label.size() > 0
    && data.label.size() <= 80
    && data.response is string
    && data.response.size() <= 1000
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidChatKeywordCreate() {
  return isValidChatKeywordFields(request.resource.data);
}

function isValidChatKeywordUpdate() {
  return isValidChatKeywordFields(request.resource.data);
}

function isValidProjectImageUriAt(list, index) {
  return list.size() <= index
    || (list[index] is string && list[index].size() <= 8192);
}

function isValidProjectImageUris(data) {
  return data.imageUris is list
    && data.imageUris.size() <= 5
    && isValidProjectImageUriAt(data.imageUris, 0)
    && isValidProjectImageUriAt(data.imageUris, 1)
    && isValidProjectImageUriAt(data.imageUris, 2)
    && isValidProjectImageUriAt(data.imageUris, 3)
    && isValidProjectImageUriAt(data.imageUris, 4);
}

/** New gallery list, or legacy single imageUri for docs not yet migrated. */
function hasValidProjectImages(data) {
  return isValidProjectImageUris(data)
    || (
      data.imageUri is string
      && data.imageUri.size() <= 8192
    );
}

function hasValidProjectMarkdownUrl(data) {
  return !('markdownUrl' in data)
    || (data.markdownUrl is string && data.markdownUrl.size() <= 8192);
}

function isValidProjectFields(data) {
  return isValidSchoolAudienceFields(data)
    && (!('track' in data) || isValidCourseTrack(data))
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 200
    && data.subtitle is string
    && data.subtitle.size() <= 300
    && data.description is string
    && data.description.size() <= 600
    && hasValidProjectImages(data)
    && hasValidProjectMarkdownUrl(data)
    && (!('imageUri' in data)
      || (data.imageUri is string && data.imageUri.size() <= 8192))
    && data.sortOrder is number
    && data.sortOrder >= 0
    && data.isPublished is bool;
}

function isValidProjectCreate() {
  let data = request.resource.data;
  return data.keys().hasAll([
      'title',
      'subtitle',
      'description',
      'imageUris',
      'markdownUrl',
      'sortOrder',
      'isPublished',
      'createdAt',
      'updatedAt',
    ])
    && isValidProjectFields(data)
    && isValidCourseTrack(data);
}

function isValidProjectUpdate() {
  return isValidProjectFields(request.resource.data);
}

function isValidContinueLearningProgress() {
  let data = request.resource.data;
  return data.videosWatched is number
    && data.videosWatched >= 0
    && data.videosWatched <= 500
    && (!('hasStartedWatching' in data) || data.hasStartedWatching is bool)
    && (
      !('watchSecondsByVideoId' in data)
      || (
        data.watchSecondsByVideoId is map
        && data.watchSecondsByVideoId.size() <= 500
      )
    );
}

function hasRequiredProfileFields() {
  return request.resource.data.keys().hasAll([
    'fullName',
    'email',
    'phoneNumber',
    'profileImage',
    'role',
    'createdAt',
    'updatedAt',
  ]);
}

// Empty phone is allowed (Google Sign-In); otherwise 10–15 digits.
function isValidPhoneNumber(value) {
  return value is string
    && (value.size() == 0
      || (value.size() >= 10 && value.size() <= 15));
}

function isValidProfileData() {
  let data = request.resource.data;
  return data.fullName is string
    && data.fullName.size() > 0
    && data.fullName.size() <= 120
    && data.email is string
    && data.email.size() > 0
    && data.email.size() <= 320
    && isValidPhoneNumber(data.phoneNumber)
    && isValidUserRole(data.role)
    && isOptionalProfileImage(data.profileImage)
    && isOptionalSchoolId(data.schoolId)
    && isOptionalGrade(data.grade)
    && isOptionalUserTrack(data.track);
}

// Updates use .update() with partial fields — validate merged document, not serverTimestamp equality.
function onlyProfileFieldsChanged() {
  return request.resource.data.diff(resource.data).affectedKeys()
    .hasOnly(['fullName', 'phoneNumber', 'profileImage', 'schoolId', 'grade', 'track', 'updatedAt']);
}

// Superadmin may change role with a partial update (role + updatedAt only).
function onlyRoleFieldsChanged() {
  return request.resource.data.diff(resource.data).affectedKeys()
    .hasOnly(['role', 'updatedAt']);
}

function isValidSuperAdminRoleAssignment() {
  return isValidUserRole(request.resource.data.role)
    && hasAllowedRoleAssignment();
}

// Superadmin may also change role (and email when correcting accounts).
function onlySuperAdminUserFieldsChanged() {
  return request.resource.data.diff(resource.data).affectedKeys()
    .hasOnly([
      'fullName',
      'phoneNumber',
      'profileImage',
      'schoolId',
      'grade',
      'track',
      'role',
      'email',
      'updatedAt',
    ]);
}

function isValidProfileDataAfterUpdate() {
  let data = request.resource.data;
  return data.fullName is string
    && data.fullName.size() > 0
    && data.fullName.size() <= 120
    && isValidPhoneNumber(data.phoneNumber)
    && hasValidProfileRoleField(data)
    && isOptionalProfileImage(data.profileImage)
    && isOptionalSchoolId(data.schoolId)
    && isOptionalGrade(data.grade)
    && isOptionalUserTrack(data.track);
}

function isValidProfileDataAfterSuperAdminUpdate() {
  let data = request.resource.data;
  return data.fullName is string
    && data.fullName.size() > 0
    && data.fullName.size() <= 120
    && data.email is string
    && data.email.size() > 0
    && data.email.size() <= 320
    && isValidPhoneNumber(data.phoneNumber)
    && isValidUserRole(data.role)
    && hasAllowedRoleAssignment()
    && isOptionalProfileImage(data.profileImage)
    && isOptionalSchoolId(data.schoolId)
    && isOptionalGrade(data.grade)
    && isOptionalUserTrack(data.track);
}

function isValidUserRole(value) {
  return value == 'user' || value == 'admin' || value == 'superadmin';
}

function hasAllowedRoleAssignment() {
  return request.resource.data.role == resource.data.role
    || request.resource.data.role == 'user'
    || request.resource.data.role == 'admin';
}

/** Accepts current roles plus legacy "admin" still stored on older profiles. */
function isStoredUserRole(value) {
  return isValidUserRole(value) || value == 'admin';
}

function hasValidProfileRoleField(data) {
  return !('role' in data) || data.role == null || isStoredUserRole(data.role);
}

function isOptionalProfileImage(value) {
  return value == null
    || value == ''
    || (value is string && value.size() <= 8192);
}

function isOptionalSchoolId(value) {
  return value == null
    || value == ''
    || (value is string && value.size() > 0 && value.size() <= 128);
}

function isOptionalGrade(value) {
  return value == null
    || value == ''
    || (value is string && value.size() > 0 && value.size() <= 32);
}

function hasSetSchoolId(data) {
  return 'schoolId' in data
    && data.schoolId != null
    && data.schoolId is string
    && data.schoolId.size() > 0;
}

function hasSetGrade(data) {
  return 'grade' in data
    && data.grade != null
    && data.grade is string
    && data.grade.size() > 0;
}

/** Once schoolId or grade is saved, that field cannot be changed or cleared. */
function schoolAndGradeImmutableOnceSet() {
  let before = resource.data;
  let after = request.resource.data;
  return (!hasSetSchoolId(before) || after.schoolId == before.schoolId)
    && (!hasSetGrade(before) || after.grade == before.grade);
}

function isOptionalUserTrack(value) {
  return value == null
    || value in ['kids', 'professionals'];
}

function signedInUserData(database) {
  return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
}

function hasClassForumMembership(database, schoolId, grade) {
  return isAuthenticated()
    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && signedInUserData(database).schoolId == schoolId
    && signedInUserData(database).grade == grade;
}

function canReadClassForumChannel(database) {
  return isAdmin(database)
    || (
      resource.data.keys().hasAll(['schoolId', 'grade'])
      && hasClassForumMembership(
        database,
        resource.data.schoolId,
        resource.data.grade,
      )
    );
}

function canAccessClassForumChannelId(database, channelId) {
  return isAdmin(database)
    || (
      exists(/databases/$(database)/documents/classForumChannels/$(channelId))
      && hasClassForumMembership(
        database,
        get(/databases/$(database)/documents/classForumChannels/$(channelId)).data.schoolId,
        get(/databases/$(database)/documents/classForumChannels/$(channelId)).data.grade,
      )
    );
}

function isValidClassForumChannelFields(data) {
  return data.schoolId is string
    && data.schoolId.size() > 0
    && data.schoolId.size() <= 128
    && data.grade is string
    && data.grade.size() > 0
    && data.grade.size() <= 32
    && data.schoolName is string
    && data.schoolName.size() > 0
    && data.schoolName.size() <= 200
    && data.title is string
    && data.title.size() > 0
    && data.title.size() <= 240
    && data.isLocked is bool
    && data.messageCount is number
    && data.messageCount >= 0
    && data.messageCount <= 1000000
    && data.lastMessagePreview is string
    && data.lastMessagePreview.size() <= 200
    && (!('lastMessageAt' in data) || data.lastMessageAt == null || data.lastMessageAt is timestamp);
}

function canCreateClassForumChannel(database) {
  let data = request.resource.data;
  return isAuthenticated()
    && data.keys().hasAll([
      'schoolId',
      'grade',
      'schoolName',
      'title',
      'isLocked',
      'messageCount',
      'lastMessagePreview',
      'createdAt',
      'updatedAt',
    ])
    && isValidClassForumChannelFields(data)
    && data.isLocked == false
    && data.messageCount == 0
    && data.lastMessagePreview == ''
    && (
      isAdmin(database)
      || hasClassForumMembership(database, data.schoolId, data.grade)
    );
}

function onlyClassForumActivityFieldsChanged() {
  return request.resource.data.diff(resource.data).affectedKeys()
    .hasOnly([
      'lastMessageAt',
      'lastMessagePreview',
      'messageCount',
      'updatedAt',
    ]);
}

function onlyClassForumLockFieldsChanged() {
  return request.resource.data.diff(resource.data).affectedKeys()
    .hasOnly(['isLocked', 'updatedAt']);
}

function canUpdateClassForumChannel(database) {
  let after = request.resource.data;
  return isValidClassForumChannelFields(after)
    && after.schoolId == resource.data.schoolId
    && after.grade == resource.data.grade
    && (
      (
        isAdmin(database)
        && (
          onlyClassForumLockFieldsChanged()
          || onlyClassForumActivityFieldsChanged()
        )
      )
      || (
        hasClassForumMembership(
          database,
          resource.data.schoolId,
          resource.data.grade,
        )
        && onlyClassForumActivityFieldsChanged()
        && after.isLocked == resource.data.isLocked
      )
    );
}

function isValidClassForumMessageCreate(data) {
  return data.keys().hasAll([
      'text',
      'senderId',
      'senderName',
      'senderRole',
      'isPinned',
      'createdAt',
      'updatedAt',
    ])
    && data.text is string
    && data.text.size() > 0
    && data.text.size() <= 1000
    && data.senderId == request.auth.uid
    && data.senderName is string
    && data.senderName.size() > 0
    && data.senderName.size() <= 120
    && isValidUserRole(data.senderRole)
    && data.isPinned == false;
}

function canCreateClassForumMessage(database, channelId) {
  let channel = get(/databases/$(database)/documents/classForumChannels/$(channelId)).data;
  return isAuthenticated()
    && exists(/databases/$(database)/documents/classForumChannels/$(channelId))
    && isValidClassForumMessageCreate(request.resource.data)
    && (
      isAdmin(database)
      || (
        hasClassForumMembership(database, channel.schoolId, channel.grade)
        && channel.isLocked == false
        && request.resource.data.senderRole == 'user'
      )
    );
}

function canDeleteClassForumMessage(database) {
  return isAdmin(database)
    || (
      isAuthenticated()
      && resource.data.senderId == request.auth.uid
      && resource.data.createdAt is timestamp
      && request.time < resource.data.createdAt + duration.value(15, 's')
    );
}

function isValidClassForumMessagePinUpdate() {
  return request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(['isPinned', 'updatedAt'])
    && request.resource.data.isPinned is bool
    && request.resource.data.text == resource.data.text
    && request.resource.data.senderId == resource.data.senderId
    && request.resource.data.senderName == resource.data.senderName
    && request.resource.data.senderRole == resource.data.senderRole;
}

function canCreateClassForumReport(database, channelId) {
  let data = request.resource.data;
  let channel = get(/databases/$(database)/documents/classForumChannels/$(channelId)).data;
  return isAuthenticated()
    && exists(/databases/$(database)/documents/classForumChannels/$(channelId))
    && data.keys().hasAll([
      'messageId',
      'messageText',
      'reportedSenderId',
      'reporterId',
      'reporterName',
      'reason',
      'createdAt',
    ])
    && data.reporterId == request.auth.uid
    && data.messageId is string
    && data.messageId.size() > 0
    && data.messageId.size() <= 128
    && data.messageText is string
    && data.messageText.size() <= 1000
    && data.reportedSenderId is string
    && data.reportedSenderId.size() > 0
    && data.reportedSenderId.size() <= 128
    && data.reporterName is string
    && data.reporterName.size() > 0
    && data.reporterName.size() <= 120
    && data.reason is string
    && data.reason.size() > 0
    && data.reason.size() <= 300
    && (
      isAdmin(database)
      || hasClassForumMembership(database, channel.schoolId, channel.grade)
    );
}
  }
}
