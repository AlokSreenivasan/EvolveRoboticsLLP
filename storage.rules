rules_version = '2';

// Deploy: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    /** Matches Firestore isAdmin: role admin or superadmin. */
    function isAdmin() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    /** Matches Firestore isSuperAdmin: role superadmin only. */
    function isSuperAdmin() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    match /profileImages/{imageFile} {
      allow read: if isAuthenticated();

      allow write: if isAuthenticated()
        && imageFile.matches(
          '^' + request.auth.uid + '\\.(jpg|jpeg|png|webp)$'
        )
        && request.resource.size < 5 * 1024 * 1024
        && isImageUpload();

      allow delete: if isAuthenticated()
        && imageFile.matches(
          '^' + request.auth.uid + '\\.(jpg|jpeg|png|webp)$'
        );
    }

    // CMS media for superadmin-only screens (Lessons, Courses, Projects):
    // any signed-in user may read; only superadmins may write/delete.
    match /continueLearningThumbnails/{uid}/{imageFile} {
      allow read: if isAuthenticated();

      allow write: if isSuperAdmin()
        && request.auth.uid == uid
        && imageFile.matches('^[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)$')
        && request.resource.size < 5 * 1024 * 1024
        && isImageUpload();

      // Any superadmin may delete so playlist cleanup works across admins.
      allow delete: if isSuperAdmin();
    }

    match /courseThumbnails/{uid}/{imageFile} {
      allow read: if isAuthenticated();

      allow write: if isSuperAdmin()
        && request.auth.uid == uid
        && imageFile.matches('^[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)$')
        && request.resource.size < 5 * 1024 * 1024
        && isImageUpload();

      allow delete: if isSuperAdmin() && request.auth.uid == uid;
    }

    // Gallery images: {projectId}_{slot}_{unique}.ext (also legacy {projectId}.ext)
    match /projectImages/{uid}/{imageFile} {
      allow read: if isAuthenticated();

      allow write: if isSuperAdmin()
        && request.auth.uid == uid
        && imageFile.matches('^[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)$')
        && request.resource.size < 5 * 1024 * 1024
        && isImageUpload();

      allow delete: if isSuperAdmin() && request.auth.uid == uid;
    }

    match /projectMarkdown/{uid}/{markdownFile} {
      allow read: if isAuthenticated();

      allow write: if isSuperAdmin()
        && request.auth.uid == uid
        && markdownFile.matches('^[A-Za-z0-9_-]+\\.md$')
        && request.resource.size < 2 * 1024 * 1024
        && isMarkdownUpload();

      allow delete: if isSuperAdmin() && request.auth.uid == uid;
    }

    // CMS media for admin-accessible screens (Resources, Assignments):
    // role "admin" and superadmin may write/delete.
    match /resourceNotes/{uid}/{pdfFile} {
      allow read: if isAuthenticated();

      allow write: if isAdmin()
        && request.auth.uid == uid
        && pdfFile.matches('^[A-Za-z0-9_-]+\\.pdf$')
        && request.resource.size < 25 * 1024 * 1024
        && isPdfUpload();

      allow delete: if isAdmin() && request.auth.uid == uid;
    }

    match /assignments/{uid}/{pdfFile} {
      allow read: if isAuthenticated();

      allow write: if isAdmin()
        && request.auth.uid == uid
        && pdfFile.matches('^[A-Za-z0-9_-]+\\.pdf$')
        && request.resource.size < 25 * 1024 * 1024
        && isPdfUpload();

      allow delete: if isAdmin() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

function isImageUpload() {
  return !('contentType' in request.resource)
    || request.resource.contentType.matches('image/.*');
}

/**
 * Object name is already constrained to *.pdf by the match rules.
 * Accept common MIME variants: iOS putFile often overrides metadata and
 * document pickers frequently report application/octet-stream.
 */
function isPdfUpload() {
  return !('contentType' in request.resource)
    || request.resource.contentType == 'application/pdf'
    || request.resource.contentType == 'application/x-pdf'
    || request.resource.contentType == 'application/octet-stream';
}

/**
 * Object name is already constrained to *.md by the match rules.
 * Accept any content type — OS / SDK MIME detection for .md is inconsistent
 * (text/markdown, text/plain, octet-stream, or vendor-specific).
 */
function isMarkdownUpload() {
  return true;
}
