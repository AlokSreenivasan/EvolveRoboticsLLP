rules_version = '2';

// Deploy: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /profileImages/{imageFile} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && imageFile.matches(
          '^' + request.auth.uid + '\\.(jpg|jpeg|png|webp)$'
        )
        && request.resource.size < 5 * 1024 * 1024
        && isImageUpload();

      allow delete: if request.auth != null
        && imageFile.matches(
          '^' + request.auth.uid + '\\.(jpg|jpeg|png|webp)$'
        );
    }

    // Playlist thumbnails: each user uploads under their own uid folder (no Firestore lookup).
    match /continueLearningThumbnails/{uid}/{imageFile} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && imageFile.matches('^[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)$')
        && request.resource.size < 5 * 1024 * 1024
        && isImageUpload();

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /courseThumbnails/{uid}/{imageFile} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && imageFile.matches('^[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)$')
        && request.resource.size < 5 * 1024 * 1024
        && isImageUpload();

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /resourceNotes/{uid}/{pdfFile} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && pdfFile.matches('^[A-Za-z0-9_-]+\\.pdf$')
        && request.resource.size < 25 * 1024 * 1024
        && isPdfUpload();

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

function isImageUpload() {
  return !('contentType' in request.resource)
    || request.resource.contentType.matches('image/.*');
}

function isPdfUpload() {
  return !('contentType' in request.resource)
    || request.resource.contentType == 'application/pdf';
}
