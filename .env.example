# Copy to `.env` and fill in values, then rebuild the native app (not just Metro reload).
# YouTube Data API v3 — enables full playlist lesson lists (500+ videos via pagination).
# Without this key, the app falls back to the public playlist RSS feed (~15 videos).
#
# Restrict this key in Google Cloud Console (API + Android/iOS app restrictions).
YOUTUBE_API_KEY=

# Optional. Firebase App Check debug provider token (debug builds only).
# Register the token under Firebase Console → App Check → Manage debug tokens.
APP_CHECK_DEBUG_TOKEN=

# Cloud Functions: set in functions/.env (see functions/.env.example).
# Keep false until Firebase Console App Check providers are live, then true + redeploy.
# ENFORCE_APP_CHECK=false
