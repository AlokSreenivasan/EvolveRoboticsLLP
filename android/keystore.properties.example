# Copy to android/keystore.properties (gitignored) and fill in real values.
# Place the release keystore under android/app/ (*.keystore is gitignored).
#
# Generate a keystore:
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore android/app/evolve-release.keystore \
#     -alias evolve-upload -keyalg RSA -keysize 2048 -validity 10000

storeFile=evolve-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=evolve-upload
keyPassword=YOUR_KEY_PASSWORD
